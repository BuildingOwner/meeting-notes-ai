{
    auto_https off
    admin off
}

# 호스트 38443 → caddy:8088 → web:3000 (default) + api:8088 (/api/*)
# openssl 로 사전 발급된 IP SAN 인증서 사용 (caddy "tls internal" 은 SNI 없는 IP 요청에서 실패).
:8088 {
    tls /certs/cert.pem /certs/key.pem

    # /api/* 는 prefix 제거 후 api 로 (FE 코드는 /jobs, /healthz 같은 평면 경로 호출).
    handle_path /api/* {
        reverse_proxy api:8088
    }

    # 그 외 모든 경로 → Next.js (web).
    handle {
        reverse_proxy web:3000
    }
}
