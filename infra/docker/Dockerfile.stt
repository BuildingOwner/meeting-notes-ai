# STT 워커 image: faster-whisper + CUDA + cuDNN. GPU 필요.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04 AS base

ENV PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3.12 python3.12-venv python3-pip ca-certificates curl \
      ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.12 /usr/local/bin/python

COPY --from=ghcr.io/astral-sh/uv:0.5.0 /uv /usr/local/bin/uv

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY apps ./apps
COPY workers ./workers

ENV MEETING_NOTES_ROOT=/data \
    STT_MODEL_PATH=/models/faster-whisper-large-v3 \
    STT_DEVICE=cuda \
    STT_GPU_INDEX=0 \
    STT_COMPUTE_TYPE=float16 \
    STT_LANGUAGE=ko \
    PYTHONPATH=/app

CMD ["/opt/venv/bin/python", "-m", "workers.stt.worker"]
