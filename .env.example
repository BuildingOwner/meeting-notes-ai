# Path to faster-whisper model directory on the host machine.
# This directory is mounted read-only into the stt container as /models.
# Required — no universal default exists.
STT_MODEL_DIR_HOST=/path/to/models/whisper

# GPU index for the STT worker (default: 0)
# STT_GPU_INDEX=0

# Override the API base URL exposed to the Next.js frontend (default: /api)
# Only needed when running the web container directly without nginx.
# NEXT_PUBLIC_API_URL=/api

# 업로드 폼 기본 Notion 대상 — 비워두면 프리필 안 함
# NOTION_DEFAULT_TARGET_ID=your-32-char-database-or-page-id
# NOTION_DEFAULT_TARGET_KIND=database
